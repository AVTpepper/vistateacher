# Public app
# Local: http://localhost:3000
# Production: App Hosting hosted.app URL first, then your custom domain
NEXT_PUBLIC_APP_URL=

# Firebase client SDK (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional native Google Docs export: Google OAuth Web application client ID.
# Enable Drive API and register exact JavaScript origins; see docs/google-docs-export.md.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=

# Local emulator switch
# true for local emulator development; false in production/App Hosting
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (server only)
# TEST requires an sk_test_ key; LIVE requires an sk_live_ key.
# The mode is a safety guard. The key and matching Price IDs select Stripe's environment.
STRIPE_MODE=TEST
# Public browser key used only to initialize Stripe's secure embedded iframe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=

# Optional legacy fallback: used only if STRIPE_PRICE_PLUS_MONTHLY is unset
STRIPE_PLUS_PRICE_ID=

# OpenAI (server only). Activation and manual period reconciliation: docs/release.md.
# A key alone cannot enable paid calls; the audited project/epoch/budget record must match.
OPENAI_API_KEY=
# Unset model currently falls back to approved mini; unknown/retired values fail closed.
OPENAI_LESSON_MODEL=gpt-4.1-mini
# Required for paid mode; leave blank until a dedicated project + budget record is audited.
OPENAI_PROJECT_ID=
OPENAI_BUDGET_EPOCH=
# Optional worksheet override. Unapproved/retired models fail closed.
OPENAI_WORKSHEET_MODEL=gpt-4.1-mini

# Select OPENAI only after the activation gate. MOCK is labelled demonstration output.
# apphosting.yaml currently omits project/epoch; supply reviewed runtime values before paid use.
AI_PROVIDER=MOCK

# Optional bootstrap list (comma-separated emails)
ADMIN_BOOTSTRAP_EMAILS=

# Transactional email and support inbox
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
