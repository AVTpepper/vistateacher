# Public app
# Local: http://localhost:3000
# Production: App Hosting hosted.app URL first, then your custom domain
NEXT_PUBLIC_APP_URL=

# Firebase client SDK (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local emulator switch
# true for local emulator development; false in production/App Hosting
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=

# Optional legacy fallback: used only if STRIPE_PRICE_PLUS_MONTHLY is unset
STRIPE_PLUS_PRICE_ID=

# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_LESSON_MODEL=gpt-4.1-mini

# OPENAI for production, MOCK for deterministic local tests
AI_PROVIDER=MOCK

# Optional bootstrap list (comma-separated emails)
ADMIN_BOOTSTRAP_EMAILS=

# Transactional email and support inbox
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
