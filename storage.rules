rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function active() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function image() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function imageWithin(limit) {
      return image() && request.resource.size <= limit;
    }

    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write: if active() && request.auth.uid == uid && imageWithin(5 * 1024 * 1024);
    }

    match /users/{uid}/cover/{fileName} {
      allow read: if true;
      allow write: if active() && request.auth.uid == uid && imageWithin(10 * 1024 * 1024);
    }

    match /posts/{uid}/{postId}/{fileName} {
      allow read: if signedIn();
      allow write: if active() && request.auth.uid == uid && imageWithin(10 * 1024 * 1024);
    }

    match /resources/{uid}/{resourceId}/{fileName} {
      allow read: if false;
      allow create, update: if active()
        && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/resources/$(resourceId))
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.authorId == uid
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.status == "uploading"
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.filePath == "resources/" + uid + "/" + resourceId + "/" + fileName
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.fileType == request.resource.contentType
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.fileSize == request.resource.size
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.openxmlformats-officedocument.presentationml.presentation|image/(jpeg|png|webp)|video/mp4)');
      allow delete: if false;
    }

    match /resources/{uid}/{resourceId}/thumbnail/{fileName} {
      allow read: if signedIn();
      allow write: if active() && request.auth.uid == uid && imageWithin(5 * 1024 * 1024);
    }

    match /messages/{conversationId}/{messageId}/{fileName} {
      allow read: if false;
      allow create: if active()
        && firestore.exists(/databases/(default)/documents/messageAttachments/$(messageId))
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.ownerId == request.auth.uid
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.conversationId == conversationId
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.status == "reserved"
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.path == "messages/" + conversationId + "/" + messageId + "/" + fileName
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.fileType == request.resource.contentType
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.fileSize == request.resource.size
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))');
      allow update, delete: if false;
    }

    match /verification/{uid}/{fileName} {
      allow read: if false;
      allow write: if active()
        && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}