rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function active() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function image() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function imageWithin(limit) {
      return image() && request.resource.size <= limit;
    }

    function postFileWithin(limit) {
      return request.resource.size <= limit
        && request.resource.contentType.matches('(application/pdf|application/msword|application/vnd.ms-(powerpoint|excel)|application/vnd.openxmlformats-officedocument.(wordprocessingml.document|presentationml.presentation|spreadsheetml.sheet)|text/(plain|csv))');
    }

    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write: if active() && request.auth.uid == uid && imageWithin(5 * 1024 * 1024);
    }

    match /users/{uid}/cover/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /posts/{uid}/{attachmentId}/{fileName} {
      allow read: if false;
      allow create: if active()
        && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/postAttachments/$(attachmentId))
        && firestore.get(/databases/(default)/documents/postAttachments/$(attachmentId)).data.ownerId == uid
        && firestore.get(/databases/(default)/documents/postAttachments/$(attachmentId)).data.state == "reserved"
        && firestore.get(/databases/(default)/documents/postAttachments/$(attachmentId)).data.expiresAt > request.time
        && firestore.get(/databases/(default)/documents/postAttachments/$(attachmentId)).data.path == "posts/" + uid + "/" + attachmentId + "/" + fileName
        && firestore.get(/databases/(default)/documents/postAttachments/$(attachmentId)).data.contentType == request.resource.contentType
        && firestore.get(/databases/(default)/documents/postAttachments/$(attachmentId)).data.size == request.resource.size
        && (imageWithin(10 * 1024 * 1024) || postFileWithin(25 * 1024 * 1024));
      allow update, delete: if false;
    }

    match /resources/{uid}/{resourceId}/{fileName} {
      allow read: if false;
      allow create: if active()
        && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/resources/$(resourceId))
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.authorId == uid
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.status == "uploading"
        && !("generatedPublicationId" in firestore.get(/databases/(default)/documents/resources/$(resourceId)).data)
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.filePath == "resources/" + uid + "/" + resourceId + "/" + fileName
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.fileType == request.resource.contentType
        && firestore.get(/databases/(default)/documents/resources/$(resourceId)).data.fileSize == request.resource.size
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|application/vnd.ms-powerpoint|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.openxmlformats-officedocument.presentationml.presentation|image/(jpeg|png|webp|heic|heif)|video/mp4)');
      allow delete: if false;
      allow update: if false;
    }

    match /resources/{uid}/{resourceId}/thumbnail/{fileName} {
      allow read: if active() && request.auth.uid == uid;
      allow write: if active() && request.auth.uid == uid && imageWithin(5 * 1024 * 1024);
    }

    match /messages/{conversationId}/{messageId}/{fileName} {
      allow read: if false;
      allow create: if active()
        && firestore.exists(/databases/(default)/documents/messageAttachments/$(messageId))
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.ownerId == request.auth.uid
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.conversationId == conversationId
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.status == "reserved"
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.path == "messages/" + conversationId + "/" + messageId + "/" + fileName
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.fileType == request.resource.contentType
        && firestore.get(/databases/(default)/documents/messageAttachments/$(messageId)).data.fileSize == request.resource.size
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))');
      allow update, delete: if false;
    }

    match /verification/{uid}/{fileName} {
      allow read: if false;
      allow write: if active()
        && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
